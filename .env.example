# Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ── Server ──────────────────────────────────────────────────────────
PORT=3000

# ── Database ─────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/voiceReceptionist?retryWrites=true&w=majority

# ── Twilio ───────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ── Google Gemini ────────────────────────────────────────────────────
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── App ──────────────────────────────────────────────────────────────
# Your publicly accessible URL (ngrok URL in dev, Render URL in prod)
BASE_URL=https://your-ngrok-or-render-url.com

# ── ngrok (local tunnel for Twilio webhooks in dev) ──────────────────
# Get free token at: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# ── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=info
NODE_ENV=development
